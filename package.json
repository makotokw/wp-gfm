{
  "name": "wp-gfm",
  "description": "GitHub Flavored Markdown for WordPress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/makotokw/wp-gfm"
  },
  "scripts": {
    "build": "sass sass/markdown.scss css/markdown.css --style=expanded --no-source-map",
    "watch": "sass sass/markdown.scss css/markdown.css --style=expanded --no-source-map --watch"
  },
  "devDependencies": {
    "sass": "^1.89.0"
  }
}
